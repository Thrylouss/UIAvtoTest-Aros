# Базовый URL тестируемого окружения
BASE_URL=https://staging.aros.uz/en

# Учётные данные для позитивных кейсов авторизации (валидный пользователь на staging)
TEST_USER_PHONE=+998000000000
TEST_USER_PASSWORD=change_me

# Заведомо неверный, но валидный по формату пароль для негативных кейсов
TEST_USER_WRONG_PASSWORD=WrongPass123

# Опционально: headless=false, чтобы смотреть браузер локально
HEADLESS=true
